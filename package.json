{
	"name": "S3-vault-CLI",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.4.2",
			"zod": "^4.4.3",
			"typescript": "^6.0.3",
			"@types/node": "^26.2.0"
		}
	},
	"type": "module",
	"scripts": {
		"vault": "bun run apps/tui/bin/vault.js",
		"test": "bun test",
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:web": "turbo run dev -F web --",
		"dev:tui": "turbo run dev -F @S3-vault-CLI/tui --",
		"link:global": "ln -sf $(pwd)/apps/tui/bin/vault.js ~/.bun/bin/vault",
		"check": "biome check --write .",
		"prepare": "husky"
	},
	"dependencies": {
		"@S3-vault-CLI/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@S3-vault-CLI/config": "workspace:*",
		"@biomejs/biome": "^2.5.6",
		"@types/node": "catalog:",
		"bun-types": "^1.4.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.2.0",
		"turbo": "^2.10.7",
		"typescript": "catalog:"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
			"biome check --write ."
		]
	},
	"packageManager": "bun@1.3.12"
}
